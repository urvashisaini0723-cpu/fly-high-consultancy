# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Brevo (Sendinblue) Email API (recommended)
# ONE integration powers BOTH the contact form and the Dream Country quiz
# (admin notification + student confirmation). See server/lib/mailer.js.
BREVO_API_KEY=your_brevo_api_key
MAIL_FROM=info@flyhighpehowa.in
# Admin notifications go here. The quiz always also notifies the owner address
# hard-coded in server/controllers/counsellingController.js.
MAIL_TO=info@flyhighpehowa.in
# Optional display name on outgoing mail (default: Fly High Consultancy Website)
MAIL_SENDER_NAME=Fly High Consultancy Website

# Optional SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Groq API for the FlyBot chatbot
# Get a free key from https://console.groq.com/keys
# Keep this file secret - never commit the real key.
GROQ_API_KEY=your_groq_api_key

# Optional: where counselling enquiries are appended (JSONL, one record per line,
# file created with 0600 perms). Defaults to server/data/enquiries.jsonl (gitignored).
# WARNING: on Render's free tier the filesystem is ephemeral and resets on redeploy —
# the two emails above are the durable copy unless you plug in a database/CRM.
# ENQUIRIES_FILE=/var/data/enquiries.jsonl

# Comma separated list of allowed frontend origins
# CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Production (Render) - set these in the Render dashboard, not in git:
# CLIENT_ORIGIN=https://*.vercel.app
# MAIL_FROM=urvashisaini0723@gmail.com
# MAIL_TO=urvashisaini0723@gmail.com
# GROQ_API_KEY / BREVO_API_KEY = same keys as local server/.env
